{
  "expo": {
    "name": "Crossing Block",
    "slug": "wheat-crossing-block",
    "version": "0.9.0",
    "orientation": "default",
    "icon": "./assets/wheat-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 9,
      "adaptiveIcon": {
        "backgroundColor": "#123047",
        "foregroundImage": "./assets/wheat-foreground.png",
        "monochromeImage": "./assets/wheat-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.wheatresearchgdm.crossingblock",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "scheme": "registrobc",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7a854070-8f7a-4099-85ce-ef983cfa7c4d"
      }
    },
    "owner": "leo_cantoni"
  }
}
